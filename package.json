{
  "name": "mausam-app-homepage",
  "private": true,
  "workspaces": [
    "mobile",
    "backend",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspace=backend",
    "mobile": "npm run start --workspace=mobile",
    "android": "npm run android --workspace=mobile",
    "ios": "npm run ios --workspace=mobile",
    "backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run backend\" \"npm run mobile\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
